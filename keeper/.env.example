# Chain the contracts are deployed on: 31337 (local anvil) or 84532 (Base Sepolia)
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545

# Wallet that posts prices and runs liquidations / limit orders / TP-SL.
# Must match KEEPER_ADDRESS used at deploy time. Local default = anvil account #1.
KEEPER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# Postgres connection string. Leave empty to use an embedded database in keeper/.data
DATABASE_URL=

PORT=8787
# Simulator / website tick
SIM_INTERVAL_MS=2000
# On-chain price updates (each costs gas). Trades also request a fresh price right before they
# execute. Heartbeats: while someone has the site open, while positions/orders are open, and idle.
VIEWER_INTERVAL_MS=20000
WATCH_INTERVAL_MS=15000
IDLE_INTERVAL_MS=300000
# Post immediately (when positions are open) if a price drifts this far from on-chain
PRICE_DEVIATION=0.005
# Skip a trade's refresh request if prices were posted this recently
FRESH_MS=3000
# Below this keeper balance (ETH) the site shows "trading paused"
LOW_GAS_ETH=0.000005
# Comma-separated list of allowed browser origins for the API
CORS_ORIGINS=http://localhost:3000
