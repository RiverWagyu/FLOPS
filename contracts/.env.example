# Used by script/Deploy.s.sol — copy to contracts/.env (never commit real keys)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Wallet that deploys and owns the contracts (needs a little Base Sepolia ETH)
DEPLOYER_PRIVATE_KEY=
# Address of the keeper wallet (the one whose key the keeper service uses)
KEEPER_ADDRESS=
# tUSD minted into the LP pool at launch (whole units)
POOL_SEED=1000000
# Optional: verify contracts on Basescan
ETHERSCAN_API_KEY=
