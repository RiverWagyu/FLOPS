# 31337 = local anvil, 84532 = Base Sepolia
NEXT_PUBLIC_CHAIN_ID=31337
# Optional custom RPC (defaults to the chain's public RPC)
NEXT_PUBLIC_RPC_URL=
# Keeper API + WebSocket
NEXT_PUBLIC_KEEPER_URL=http://localhost:8787
# WalletConnect Cloud project id (optional; enables the WalletConnect QR option)
NEXT_PUBLIC_WC_PROJECT_ID=

# Server-only: Coinbase Developer Platform paymaster URL for Base Sepolia.
# When set, Base Account users trade with zero test ETH.
PAYMASTER_URL=
